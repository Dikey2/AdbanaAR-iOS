{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      "$uid": {
        "pedidos": {
          ".read": "auth != null && auth.uid === $uid",
          ".indexOn": ["pedidoId"],
          "$pedido": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['slug', 'pedidoId', 'restaurante', 'estado', 'total'])",
            "slug": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "pedidoId": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "restaurante": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "estado": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "total": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "actualizadoEn": { ".validate": "newData.isNumber()" },
            "$otro": { ".validate": false }
          }
        }
      }
    }
  }
}
